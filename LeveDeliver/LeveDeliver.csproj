<Project Sdk="Dalamud.NET.Sdk/15.0.0">

  <PropertyGroup>
    <Authors>Hangovers</Authors>
    <Version>1.0.0</Version>
    <Description>One-click repeat leve delivery (Deliver All).</Description>
    <PackageProjectUrl>https://github.com/hangovers/LeveDeliver</PackageProjectUrl>
    <IsPackable>false</IsPackable>
    <TargetFramework>net10.0-windows</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ProduceReferenceAssembly>false</ProduceReferenceAssembly>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>

  <!--
    DalamudLibPath: let the Dalamud.NET.Sdk resolve it (Windows: %APPDATA%\XIVLauncher\addon\Hooks\dev\
    for the release launcher, or the launcher's own data dir for dev launchers; Linux: ~/.xlcore/dalamud/Hooks/dev/).
    Do NOT force a hardcoded path here — the user's XIVLauncher dev build uses a different data directory
    (dev.goats.xivlauncher), and a forced wrong path produces binaries built against the wrong Dalamud
    assemblies, which fail to load in-game.
  -->

  <ItemGroup>
    <Content Include="LeveDeliver.json" />
    <Content Include="Data\LeveDatabase.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\icon.png" CopyToOutputDirectory="PreserveNewest" Link="icon.png" />
    <EmbeddedResource Include="Data\LeveDatabase.json" />
  </ItemGroup>

  <ItemGroup>
    <!--
      ECommons: prefer the submodule ProjectReference when initialized
      (orchestrator runs `git submodule add/update`). If it is missing
      (e.g. no network during build), compile the vendored sources under
      ECommonsVendored/ instead.
    -->
    <ProjectReference Include="..\ECommons\ECommons\ECommons.csproj" Condition="Exists('..\ECommons\ECommons\ECommons.csproj')" />
    <Compile Remove="ECommonsVendored\**\*.cs" Condition="Exists('..\ECommons\ECommons\ECommons.csproj')" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Update="DalamudPackager" Version="15.0.0" />
    <PackageReference Update="DotNet.ReproducibleBuilds" Version="2.0.2" />
  </ItemGroup>

  <ItemGroup Condition="!Exists('..\ECommons\ECommons\ECommons.csproj')">
    <!--
      Vendored-mode only: the ECommons submodule provides ImGui bindings and the
      Dalamud IPC types transitively. Without it we reference the game's native
      ImGui.NET (ImGuiNET namespace) and the Dalamud bindings directly.
      The ImGui.NET package's bundled cimgui native lib is excluded — the game
      host provides cimgui.dll.
    -->
    <PackageReference Include="ImGui.NET" Version="1.91.6.1" ExcludeAssets="runtime;native" />
    <Reference Include="Dalamud.Bindings.ImGui">
      <HintPath>$(DalamudLibPath)Dalamud.Bindings.ImGui.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Dalamud.Bindings.ImGuizmo">
      <HintPath>$(DalamudLibPath)Dalamud.Bindings.ImGuizmo.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
